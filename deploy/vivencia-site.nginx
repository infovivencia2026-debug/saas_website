# Vivencia EduCloud — marketing site (static)
# Separate root and hostname from the ERP app at college.187-127-178-100.sslip.io.
#
# One rule governs the whole file: `add_header` inside a location REPLACES
# every add_header inherited from the server block — it does not add to them.
# Caching used to be set in a `location = /index.html`, and since / is served
# through that location, the page itself was answering with no security
# headers at all while every other path had them.
#
# So the cache policy is chosen by response type in this map and emitted once,
# beside the security headers, at server level. No location below sets a
# header, which is what keeps them all inherited.

map $sent_http_content_type $vivencia_cache {
    default                      "public, max-age=604800";   # 7d — assets
    ~*^text/html                 "no-cache, must-revalidate"; # the page itself
    ~*^(text/plain|application/xml|text/xml) "public, max-age=3600";  # robots, sitemap
}

server {
    server_name vivencia.187-127-178-100.sslip.io;

    location /.well-known/acme-challenge/ { root /var/www/html; }

    root /var/www/vivencia-site;
    index index.html;

    location / { try_files $uri $uri.html $uri/ =404; }

    # a styled 404 instead of nginx's default page
    error_page 404 /404.html;
    location = /404.html { internal; }

    # deploy.sh stamps styles.css with ?v=<release>, so the long asset cache
    # in the map above can never strand a visitor on a stale stylesheet
    location ~* \.(css|js|svg|png|jpe?g|webp|avif|woff2?)$ { access_log off; }
    location ~* ^/(robots\.txt|sitemap\.xml)$ { access_log off; }

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json
               application/ld+json application/xml image/svg+xml;

    add_header Cache-Control $vivencia_cache always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    # HTTPS only, and remembered. The certificate auto-renews, so there is no
    # window where the site is reachable over plain HTTP and this would lock
    # visitors out.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    # the page asks for no device permissions at all
    add_header Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=(), usb=(), interest-cohort=()" always;
    # The page is two files plus Google Fonts. Inline style and script are
    # needed: the theme is set before first paint by an inline script, the
    # cursor and several diagrams are inline data: SVGs, and the node styles
    # that place the orbit are set as inline custom properties.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'" always;

    listen [::]:443 ssl; # managed by Certbot
    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/vivencia.187-127-178-100.sslip.io/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/vivencia.187-127-178-100.sslip.io/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

}


server {
    if ($host = vivencia.187-127-178-100.sslip.io) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    listen 80;
    listen [::]:80;
    server_name vivencia.187-127-178-100.sslip.io;
    return 404; # managed by Certbot


}