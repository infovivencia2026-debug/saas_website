# Vivencia EduCloud — marketing site (static, two files)
# Separate root and hostname from the ERP app at college.187-127-178-100.sslip.io.

server {
    server_name vivencia.187-127-178-100.sslip.io;

    location /.well-known/acme-challenge/ { root /var/www/html; }

    root /var/www/vivencia-site;
    index index.html;

    location / { try_files $uri $uri.html $uri/ =404; }

    location = /index.html {
        add_header Cache-Control "no-cache, must-revalidate";
    }
    location ~* \.(css|js|svg|png|jpe?g|webp|avif|woff2?)$ {
        expires 7d;
        add_header Cache-Control "public";
        access_log off;
    }

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript image/svg+xml;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    listen [::]:443 ssl; # managed by Certbot
    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/vivencia.187-127-178-100.sslip.io/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/vivencia.187-127-178-100.sslip.io/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

}


server {
    if ($host = vivencia.187-127-178-100.sslip.io) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    listen 80;
    listen [::]:80;
    server_name vivencia.187-127-178-100.sslip.io;
    return 404; # managed by Certbot


}